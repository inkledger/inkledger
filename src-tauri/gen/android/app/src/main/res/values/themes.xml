<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: the launch and the space around the web view are the app's canvas. -->
    <style name="Theme.inkledger" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
