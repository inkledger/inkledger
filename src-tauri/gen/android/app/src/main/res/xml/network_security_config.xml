<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Besides the system CAs, trust the ones the user installed:
     the certificate of a Mac sharing inkledger on the Wi-Fi (src-tauri/src/lan.rs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
