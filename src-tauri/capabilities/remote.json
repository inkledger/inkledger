{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "The user's server (Tailscale names and this machine): native features only, no file system or shell.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://*.ts.net",
      "https://*.ts.net/*",
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:event:default",
    "opener:default",
    "allow-list-profiles",
    "allow-get-locale",
    "allow-set-locale",
    "allow-remove-profile",
    "allow-rename-profile",
    "allow-add-profile",
    "allow-open-profile",
    "allow-set-profile-info",
    "allow-manage-profiles",
    "allow-forget-server",
    "allow-set-tray-state",
    "allow-notify",
    "allow-native-info",
    "allow-set-autostart",
    "allow-show-window",
    "allow-notification-permission",
    "allow-request-notification-permission",
    "allow-open-system-settings",
    "allow-lan-status",
    "allow-lan-start",
    "allow-lan-stop",
    "allow-tailscale-info",
    "allow-tailscale-serve"
  ]
}
