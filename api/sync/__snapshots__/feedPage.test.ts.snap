exports[`the worklog feed, page by page > changed on both sides: a queued change here, or its sink not synced, keeps ours and the service's beside it 1`] = `
{
  "outbox": [
    {
      "issue_key": "FAKE-1",
      "jira_worklog_id": "r1",
      "kind": "update",
    },
  ],
  "worklogs": [
    {
      "author_account_id": "me",
      "comment": "mine",
      "conn": "https://a.example",
      "issue_key": "FAKE-1",
      "jira_worklog_id": "r1",
      "locked": null,
      "remote_id": "r1",
      "remote_snapshot": "{"seconds":600,"started":1792047600000,"comment":"theirs"}",
      "started": 1792047600000,
      "state": "conflict",
      "time_spent_seconds": 600,
      "version": "v9",
    },
    {
      "author_account_id": "me",
      "comment": "mine too",
      "conn": "https://a.example",
      "issue_key": "FAKE-1",
      "jira_worklog_id": "r2",
      "locked": null,
      "remote_id": "r2",
      "remote_snapshot": "{"seconds":600,"started":1792051200000,"comment":"theirs too"}",
      "started": 1792051200000,
      "state": "conflict",
      "time_spent_seconds": 600,
      "version": null,
    },
    {
      "author_account_id": "me",
      "comment": "only theirs",
      "conn": "https://a.example",
      "issue_key": "FAKE-1",
      "jira_worklog_id": "r3",
      "locked": null,
      "remote_id": "r3",
      "remote_snapshot": null,
      "started": 1792054800000,
      "state": "synced",
