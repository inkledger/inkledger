{
  "name": "inkledger",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:build": "pnpm build && SERVE_BUILD=1 tsx api/boot.ts",
    "build": "vite build && vite build --config vite.ssr.config.ts && node scripts/precompress.mjs && esbuild api/boot.ts api/cli.ts --platform=node --bundle --format=esm --packages=external --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "lint": "eslint . && node scripts/check-design.mjs",
    "preview": "PORT=${PORT:-4173} pnpm dev:build",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "theme:tokens": "node scripts/gen-theme-tokens.mjs",
    "docs:design-system": "node scripts/design-system-pdf.mjs",
    "icons": "node scripts/icons.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:ios": "tauri ios dev",
    "tauri:android": "tauri android dev",
    "test:e2e": "pnpm build && node --test --test-concurrency=2 --test-timeout=300000 'e2e/*.test.mjs'",
    "test:db": "docker compose -f deploy/dev.yml up -d --wait test-db",
    "dev:services": "docker compose -f deploy/dev.yml --profile ai --profile ml up -d --wait",
    "dev:down": "docker compose -f deploy/dev.yml --profile ai --profile ml down",
    "native:publish": "node scripts/native-publish.mjs",
    "dist": "node scripts/dist.mjs",
    "docker:update": "node scripts/docker-update.mjs",
    "docker:from-dev": "node scripts/docker-from-dev.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "perf": "node scripts/perf.mjs",
    "db:generate": "drizzle-kit generate",
    "user:reset": "tsx api/cli.ts reset-password",
    "catalog:matrix": "tsx api/providers/catalogMatrixCli.ts",
    "parity:update": "tsx api/parity/cli.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@radix-ui/react-context-menu": "2.4.1",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "postal-mime": "4.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.6",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@hono/vite-dev-server": "^0.26.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "axe-core": "4.14.0",
    "better-sqlite3": "^12.11.1",
    "chrome-launcher": "1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "lighthouse": "13.5.0",
    "lucide-react": "^0.562.0",
    "next-themes": "0.4.6",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "uqr": "^0.1.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
